<Window x:Class="CEFRSubtitleMasker.LevelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seviye Seçimi" Height="250" Width="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        Background="#2D2D30"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="İngilizce Seviyenizi Seçin" 
                   Foreground="White" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ComboBox x:Name="LevelComboBox" Grid.Row="1" VerticalAlignment="Center" 
                  FontSize="16" Height="35" Padding="5">
            <ComboBoxItem Content="A1 - Beginner" Tag="1"/>
            <ComboBoxItem Content="A2 - Elementary" Tag="2"/>
            <ComboBoxItem Content="B1 - Intermediate" Tag="3" IsSelected="True"/>
            <ComboBoxItem Content="B2 - Upper Intermediate" Tag="4"/>
            <ComboBoxItem Content="C1 - Advanced" Tag="5"/>
            <ComboBoxItem Content="C2 - Mastery" Tag="6"/>
        </ComboBox>

        <Button x:Name="StartButton" Grid.Row="2" Content="Başlat" 
                Height="40" FontSize="16" FontWeight="Bold"
                Background="#007ACC" Foreground="White" BorderThickness="0"
                Click="StartButton_Click" Cursor="Hand"/>
    </Grid>
</Window>